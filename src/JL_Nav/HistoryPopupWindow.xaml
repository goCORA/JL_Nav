<Window x:Class="JL_Nav.HistoryPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JL_Nav history"
        Icon="Assets/jl_icon.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="White"
        Deactivated="Window_Deactivated">
    <Border BorderBrush="#FF888888" BorderThickness="1" Padding="6">
        <StackPanel>
            <TextBlock Text="Click a node to jump that window there"
                       FontSize="11" Foreground="Gray" Margin="2,0,2,6"/>
            <ScrollViewer MaxWidth="900" MaxHeight="600"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TreesPanel"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
